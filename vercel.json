{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico/%D0%B4%D0%B8%D0%BFng.png",
      "destination": "/favicon.ico/%D0%B4%D0%B8%D0%BFng.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
